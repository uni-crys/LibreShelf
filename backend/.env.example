# Copy to backend/.env and fill in values locally. Never commit backend/.env.
GOOGLE_BOOKS_API_KEY=

# Shared secret used only by the local Readmoo sync agent and the VPS backend.
# Generate a different long random value for your own installation.
READMOO_SYNC_TOKEN=

# Local-machine only: the Tailscale Serve URL of the VPS, without /api.
# Example: https://libreshelf.example.ts.net
READMOO_SYNC_VPS_URL=
